# KOMA web server on Arbitrum One. Copy to the hosting provider's env (never commit real values).
# Public values are inlined into the browser bundle at build time (NEXT_PUBLIC_*).

NEXT_PUBLIC_KOMA_NETWORK=arbitrum-one
# A dedicated RPC (Alchemy/QuickNode/Infura…) for the browser; the public one rate-limits.
NEXT_PUBLIC_ARBITRUM_RPC_URL=
# The server's own RPC (can be the same provider, a different key).
KOMA_SERVER_RPC_URL=
KOMA_PUBLIC_URL=https://

# Relayer + x402 facilitator hot wallet. Holds only gas (keep ≥ 0.02 ETH); it has
# operational roles (launch, propose/finalize, mint) and NO admin role.
SERVER_PRIVATE_KEY=
# Where x402 payments (comics, episodes, launches) land: the treasury Safe.
KOMA_PAY_TO=
# KomaIssues address from deploy/addresses.42161.json (the server also reads that file).
KOMA_CONTRACT=

FAL_KEY=
KOMA_LLM_MODEL=anthropic/claude-sonnet-4.5
# Daily fal spend cap in USD; new launches and issues answer 503 above it.
KOMA_FAL_DAILY_USD=50

# Optional: ERC-7677 gas sponsorship for wallets that send trades themselves.
PIMLICO_API_KEY=
PIMLICO_POLICY_ID=

# Persistent volume for SQLite + art.
KOMA_DATA_DIR=/data

# Rate limits (defaults shown).
KOMA_CHAT_PER_HOUR=600
KOMA_RELAY_PER_HOUR=1500
KOMA_PAYMASTER_PER_HOUR=600
