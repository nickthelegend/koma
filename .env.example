# Which chain KOMA charges on: arbitrum-sepolia (default) or arbitrum-one
NEXT_PUBLIC_KOMA_NETWORK=arbitrum-sepolia
# Optional RPC override (browser + server). Defaults to the public Arbitrum RPC.
NEXT_PUBLIC_ARBITRUM_RPC_URL=

# Server key: pays facilitator gas and holds MINTER_ROLE on KomaIssues. Fund it with a little ETH on the chain above.
SERVER_PRIVATE_KEY=
# KomaIssues address from `forge script script/Deploy.s.sol` (contracts/)
KOMA_CONTRACT=
# Where USDC goes. Defaults to the server key's address.
KOMA_PAY_TO=
# fal.ai key for the script (any-llm) and the panels (FLUX dev)
FAL_KEY=
KOMA_LLM_MODEL=anthropic/claude-sonnet-4.5

# Public origin, used in token metadata
KOMA_PUBLIC_URL=http://localhost:4310
# Where issues, jobs and art are stored
KOMA_DATA_DIR=

# Local fork only (scripts/chain.sh, scripts/local-setup.sh, scripts/e2e-api.mjs)
KOMA_FORK_BLOCK=
SERVER_ADDRESS=
TEST_BROWSER_KEY=
TEST_BROWSER_ADDRESS=
TEST_AGENT_KEY=
TEST_AGENT_ADDRESS=
TEST_EMPTY_KEY=
TEST_EMPTY_ADDRESS=
TEST_PAYTO_KEY=
TEST_PAYTO_ADDRESS=
