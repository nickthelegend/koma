  "css": ".card-intro .big{position:absolute;left:150px;top:150px;display:flex;align-items:center;gap:34px}.card-intro .logo{background:var(--kapow);color:#000;font-family:Anton,sans-serif;font-size:260px;line-height:.9;padding:20px 40px 0;box-shadow:16px 16px 0 #000,16px 16px 0 3px var(--paper)}.card-intro .tag{position:absolute;left:150px;top:560px;font-family:Anton,sans-serif;font-size:150px;line-height:.95;text-transform:uppercase;color:var(--paper)}.card-intro .tag span{display:block}.card-intro .chips{position:absolute;left:150px;bottom:150px;display:flex;gap:16px}.card-intro .chip{font-family:'JetBrains Mono',monospace;font-weight:800;font-size:26px;padding:10px 18px;border:3px solid var(--paper);color:var(--paper)}.card-intro .chip.a{background:var(--arb);border-color:var(--arb);color:#000}.card-intro .price{position:absolute;right:170px;top:170px;width:280px;height:280px;background:var(--paper);color:#000;border:6px solid #000;box-shadow:12px 12px 0 var(--kapow);display:flex;flex-direction:column;align-items:center;justify-content:center;font-family:Anton,sans-serif}.card-intro .price b{font-size:150px;line-height:.9;font-weight:400}.card-intro .price i{font-style:normal;font-size:34px}",
  "html": "<div class='halftone'></div><div class='big'><div class='logo' id='in-logo'>KOMA</div></div><div class='price' id='in-price'><b>10\u00a2</b><i>A PAGE</i></div><div class='tag'><span id='in-t1'>Write it.</span><span id='in-t2' style='color:var(--kapow)'>We draw it.</span></div><div class='chips'><div class='chip a' id='in-c1'>ARBITRUM</div><div class='chip' id='in-c2'>x402 USDC</div><div class='chip' id='in-c3'>STYLUS \u00b7 RUST</div><div class='chip' id='in-c4'>ERC-6551</div><div class='chip' id='in-c5'>UNISWAP V4</div></div>",
  "js": "tl.fromTo('#in-logo',{scale:2.4,rotation:-8,opacity:0},{scale:1,rotation:-2,opacity:1,duration:.55,ease:'expo.out'},$S+0.1);tl.fromTo('#in-price',{y:-500,rotation:18},{y:0,rotation:6,duration:.7,ease:'bounce.out'},$S+0.55);tl.fromTo('#in-t1',{x:-200,opacity:0},{x:0,opacity:1,duration:.45,ease:'power3.out'},$S+0.9);tl.fromTo('#in-t2',{x:-200,opacity:0},{x:0,opacity:1,duration:.45,ease:'power3.out'},$S+1.25);tl.fromTo(['#in-c1','#in-c2','#in-c3','#in-c4','#in-c5'],{y:40,opacity:0},{y:0,opacity:1,duration:.35,stagger:.12,ease:'power3.out'},$S+1.8);tl.to('#in-logo',{scale:1.04,duration:2.5,ease:'sine.inOut'},$S+1);"
 },
