{
  "name": "koma",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4310",
    "build": "next build",
    "start": "next start -p 4310",
    "lint": "eslint",
    "chain": "sh scripts/chain.sh",
    "contracts:test": "cd contracts && forge test",
    "contracts:deploy": "cd contracts && forge script script/Deploy.s.sol --rpc-url ${RPC_URL:-arbitrum_sepolia} --broadcast",
    "buy": "node scripts/buy-comic.mjs",
    "contracts:test:fork": "cd contracts && FORK_TESTS=1 forge test --match-path 'test/fork/*'",
    "stylus:test": "cd stylus && cargo test",
    "test:api": "node scripts/e2e-api.mjs",
    "test:launchpad": "node scripts/e2e-launchpad.mjs",
    "check:economics": "node scripts/check-economics.mjs",
    "preflight:mainnet": "node scripts/mainnet-preflight.mjs",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "@x402/core": "^2.27.0",
    "@x402/evm": "^2.27.0",
    "@x402/fetch": "^2.27.0",
    "@x402/next": "^2.27.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "^2.56.9",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@uniswap/v4-core": "^1.0.2",
    "@uniswap/v4-periphery": "^1.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.13"
  }
}
